<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper">
    
<xacro:include filename="$(find dual_piper_v2)/urdf/piper_mamo.xacro"/>

    <xacro:namespace namespace="piper_1">
    </xacro:namespace>

    <xacro:namespace namespace="piper_2">
    </xacro:namespace>

    <xacro:namespace namespace="piper_3">
    </xacro:namespace>

    <xacro:namespace namespace="piper_4">
